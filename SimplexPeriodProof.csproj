<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ResoniteDirectory Condition="'$(ResoniteDirectory)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Resonite</ResoniteDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot" Version="5.1.59" />
    <Reference Include="Elements.Core">
      <HintPath>$(ResoniteDirectory)\Elements.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="CheckElementsCore" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ResoniteDirectory)\Elements.Core.dll')"
           Text="Elements.Core.dll was not found. Set ResoniteDirectory to the Resonite installation directory." />
  </Target>
</Project>
